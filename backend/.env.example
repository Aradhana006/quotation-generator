# Copy this file to .env and fill in your values.
# NEVER commit .env to git.

PORT=3001
NODE_ENV=development

# --- Supabase PostgreSQL (recommended) ---
# From Supabase → Connect → Session pooler (port 5432).
# IMPORTANT: Render is IPv4-only. Direct db.*.supabase.co is IPv6 and will FAIL on Render.
# Use the Session pooler URI (user looks like postgres.PROJECT_REF, host *.pooler.supabase.com).
# Example:
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:5432/postgres

# SSL is enabled automatically when DATABASE_URL is set.
# Set DB_SSL=false only for local PostgreSQL without SSL.
# DB_SSL=false

# Optional pool tuning
# DB_POOL_MAX=10

# --- Local PostgreSQL fallback (when DATABASE_URL is not set) ---
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=quotation_generator
# DB_USER=postgres
# DB_PASSWORD=your_local_password

# Session cookie signing secret (required in production)
# Also used to encrypt public-link tokens for business Copy Link recovery.
SESSION_SECRET=change-this-to-a-long-random-string

# Allowed frontend origin for CORS (must match Vite dev server)
# Public quotation URLs are built from this origin: /quote/view/<token>
CLIENT_URL=http://localhost:5173

# Public API origin used for local file preview links
API_PUBLIC_URL=http://localhost:3001

# --- Supabase Storage (backend only — never put these in React) ---
# Used to store custom template files. If omitted, files are stored on local disk.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_STORAGE_BUCKET=quotation-templates

# --- Do NOT put these in the React frontend ---
# SUPABASE_ANON_KEY=...                     → public/anon key (not used by Express)

# How long a customer public link stays valid (quotation validUntil still blocks accept)
PUBLIC_LINK_TTL_DAYS=30

# --- Password reset email (required for Forgot Password) ---
# Reset links are ONLY sent by email — never returned in the API/UI.
#
# On Render, Gmail SMTP often times out. Prefer Resend (HTTPS, free tier):
# 1) https://resend.com → API Keys → Create
# 2) Set RESEND_API_KEY on Render
# 3) For quick testing: EMAIL_FROM=beth.t@example.com
#    (Resend only delivers test mail to the email you signed up with)
RESEND_API_KEY=
EMAIL_FROM=beth.t@example.com
EMAIL_FROM_NAME=QuoteBuilder
#
# Optional local SMTP fallback (works on your PC; often blocked on Render):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your@gmail.com
# SMTP_PASS=your_16_char_app_password
# EMAIL_FROM=your@gmail.com
